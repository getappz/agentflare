/target
/.docs/
/domain-research/
/skills/
/.worktrees/

# Machine-local docs output / notes, not part of the project
/docs/

# Competitive audit clones and reports — large, transient, per-machine
/.competitive-audit/
# Reference clones of external repos for code analysis — large, transient, per-machine
/.refs/

# Local opencode config — carries per-machine MCP server paths, not shared
/opencode.json

# Cursor local hooks/rules — per-machine editor config, not shared
/.cursor/

# opencode CLI's own local state (node_modules, package.json/lock, plans dir)
/.opencode/

# Per-repo agentflare-backend project link (Vercel-style .vercel/project.json
# equivalent) — machine-local, not something to share via git. Workflow
# definitions/scripts under workflows/ and scripts/ ARE meant to be versioned
# (per the workflow engine's own convention), so they're carved out below.
/.agentflare/*
!/.agentflare/workflows/
!/.agentflare/scripts/

# Local onpush doc-generation tooling (machine-specific, not part of the project)
/.onpush/
/onpush_run.log
/install_onpush.ps1
/run_onpush.bat
/serve_docs.py

# Claude Code local runtime artifacts (machine-local, not shared)
# NOTE: do NOT ignore .claude/ wholesale — .claude/skills/pm/ is tracked/shared.
.claude/worktrees/
.claude/projects/
.claude/history/
.claude/todos/
.claude/stats.json

# mise tasks are personal dev-workflow shortcuts, not shared project config
/.mise.toml
/.mise/

# aube workspace (site/ + docs-site/) — installed deps, not source.
# aube-lock.yaml IS committed (reproducible installs); node_modules isn't.
node_modules/

# subagent-driven-development scratch workspace for item #112's plan —
# ledger/briefs/reports/review packages, not source.
/.superpowers/
/.agent-scratch/
.sccache-cache/
 
# Flare Desktop -- private sibling repo getappz/flare-desktop, not part of agentflare 
/flare-desktop/ 
