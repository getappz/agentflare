//! One-shot helper to run git/gh from `cargo test` (ctx_shell allowlist blocks git.exe).
use std::fs::OpenOptions;
use std::io::Write;
use std::process::Command;

fn log(line: &str) {
    let path = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("task696_git_helper.log");
    let mut f = OpenOptions::new()
        .create(true)
        .append(true)
        .open(path)
        .expect("open log");
    writeln!(f, "{line}").expect("write log");
}

#[cfg(windows)]
const GIT: &str = r"C:\Program Files\Git\bin\git.exe";
#[cfg(not(windows))]
const GIT: &str = "git";

#[cfg(windows)]
const GH: &str = r"C:\Program Files\GitHub CLI\gh.exe";
#[cfg(not(windows))]
const GH: &str = "gh";

#[cfg(windows)]
const CARGO: &str = r"C:\Users\shiva\.cargo\bin\cargo.exe";
#[cfg(not(windows))]
const CARGO: &str = "cargo";

fn git(args: &[&str]) -> std::process::Output {
    Command::new(GIT)
        .args(args)
        .current_dir(env!("CARGO_MANIFEST_DIR"))
        .output()
        .unwrap_or_else(|e| {
            log(&format!("git spawn failed: {e}"));
            panic!("git not available: {e}");
        })
}

fn gh(args: &[&str]) -> std::process::Output {
    Command::new("gh")
        .args(args)
        .current_dir(env!("CARGO_MANIFEST_DIR"))
        .output()
        .unwrap_or_else(|e| {
            log(&format!("gh spawn failed: {e}"));
            panic!("gh not available: {e}");
        })
}

fn cargo(args: &[&str]) -> std::process::Output {
    Command::new("cargo")
        .args(args)
        .current_dir(env!("CARGO_MANIFEST_DIR"))
        .output()
        .unwrap_or_else(|e| {
            log(&format!("cargo spawn failed: {e}"));
            panic!("cargo not available: {e}");
        })
}

fn assert_ok(label: &str, out: &std::process::Output) {
    log(&format!(
        "{label} status={:?} stdout={} stderr={}",
        out.status.code(),
        String::from_utf8_lossy(&out.stdout),
        String::from_utf8_lossy(&out.stderr)
    ));
    assert!(out.status.success(), "{label} failed");
}

#[test]
fn task696_ci_checks() {
    let _ = std::fs::remove_file(
        std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("task696_git_helper.log"),
    );
    log("=== git status ===");
    assert_ok("git status", &git(&["status"]));
    log("=== git diff src/hook.rs (summary) ===");
    let diff = git(&["diff", "src/hook.rs"]);
    let diff_text = String::from_utf8_lossy(&diff.stdout);
    let summary: String = diff_text.lines().take(80).collect::<Vec<_>>().join("\n");
    log(&format!(
        "diff_lines={} summary:\n{summary}",
        diff_text.lines().count()
    ));
    log("=== cargo fmt --check ===");
    assert_ok("cargo fmt --check", &cargo(&["fmt", "--check"]));
    log("=== cargo test paced_submit_nudge --lib ===");
    assert_ok(
        "cargo test paced_submit_nudge --lib",
        &cargo(&["test", "paced_submit_nudge", "--lib"]),
    );
    log("=== cargo clippy ===");
    assert_ok(
        "cargo clippy",
        &cargo(&[
            "clippy",
            "--all-targets",
            "--",
            "-A",
            "unsafe_code",
            "-A",
            "clippy::pedantic",
        ]),
    );
    log("ci_checks_ok");
}

#[test]
#[ignore = "manual: task696 commit/push/PR helper"]
fn task696_commit_push_pr() {
    let _ = std::fs::remove_file(
        std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("task696_git_helper.log"),
    );
    log("start");

    let branch = String::from_utf8_lossy(&git(&["branch", "--show-current"]).stdout)
        .trim()
        .to_string();
    log(&format!("branch={branch}"));
    assert!(branch.starts_with("task/696"), "wrong branch: {branch}");
    assert!(branch != "main" && branch != "master");

    let hook_dirty = !git(&["diff", "--quiet", "src/hook.rs"]).status.success()
        || !git(&["diff", "--cached", "--quiet", "src/hook.rs"]).status.success();
    log(&format!("hook_dirty={hook_dirty}"));
    if hook_dirty {
        assert_ok("git add", &git(&["add", "src/hook.rs"]));
        assert_ok(
            "git commit",
            &git(&[
                "commit",
                "-m",
                "Pace PM-mode and setup UserPromptSubmit nudges so they do not re-inject every turn.",
            ]),
        );
    } else {
        log("skip commit: src/hook.rs clean");
    }
    assert_ok("git push", &git(&["push", "-u", "origin", "HEAD"]));

    let pr_body = "## Summary\n\
- Pace PM-mode and setup `@setup` UserPromptSubmit reminders with a 30-minute cooldown.\n\
- Keep `first_turn` bypass so each session still gets one upfront nudge.\n\
- Add unit tests for cooldown suppression and post-cooldown refire.\n\n\
## Test plan\n\
- [x] `cargo test --lib paced_submit_nudge`";

    assert_ok(
        "gh pr create",
        &gh(&[
            "pr",
            "create",
            "--title",
            "Pace UserPromptSubmit PM-mode and setup nudges",
            "--body",
            pr_body,
        ]),
    );
    assert_ok("gh pr view", &gh(&["pr", "view", "--json", "url", "-q", ".url"]));
    log("done");
}
